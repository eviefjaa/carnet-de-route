rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Préférences, rappels envoyés et anciens voyages (avant le partage) :
    // chacun ne peut lire et modifier que les siens
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Voyages, partagés entre leurs voyageurs :
    //   owner (créateur), members (uid des voyageurs), invites (e-mails invités, en minuscules),
    //   emails ({ uid: e-mail } des voyageurs), joined ({ uid: date d'arrivée }, pour les notifications)
    match /trips/{tripId} {
      function signedIn() { return request.auth != null; }
      function uid() { return request.auth.uid; }
      function email() { return request.auth.token.email.lower(); }
      function isMember() { return uid() in resource.data.members; }
      function isOwner() { return resource.data.owner == uid(); }
      // Invité(e) : seulement avec une adresse confirmée, sinon n'importe qui
      // pourrait créer un compte avec l'adresse invitée
      function isInvited() { return request.auth.token.email_verified == true && email() in resource.data.invites; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function newData() { return request.resource.data; }
      // Forme minimale d'un voyage : sinon un voyageur pourrait bloquer l'affichage des autres
      function validTrip() {
        return newData().items is list
          && newData().name is string && newData().name.size() <= 200
          && (!("currency" in newData()) || (newData().currency is string && newData().currency.size() <= 3));
      }

      allow read: if signedIn() && (isMember() || isInvited());

      allow create: if signedIn() && validTrip()
        && newData().owner == uid()
        && newData().members == [uid()]
        && newData().invites == []
        && newData().emails.keys().hasOnly([uid()])
        && newData().emails[uid()] == request.auth.token.email
        && !("joined" in newData());

      // Seul le créateur supprime le voyage
      allow delete: if signedIn() && isOwner();

      allow update: if signedIn() && validTrip() && newData().invites is list && newData().invites.size() <= 30 && (
        // Le créateur change tout, sauf le créateur, et reste dans le voyage.
        // Il peut retirer des voyageurs mais pas en ajouter : on n'entre que sur invitation
        (isOwner() && newData().owner == resource.data.owner && uid() in newData().members
            && resource.data.members.hasAll(newData().members)
            // Adresses des voyageurs : il peut en retirer, jamais en modifier ni en ajouter
            && newData().emails.diff(resource.data.emails).addedKeys().size() == 0
            && newData().emails.diff(resource.data.emails).changedKeys().size() == 0
            && !changed().hasAny(["joined"]))
        // Un voyageur modifie le contenu ou invite quelqu'un (sans retirer d'invitation)
        || (isMember() && !changed().hasAny(["owner", "members", "emails", "joined"])
            && newData().invites.hasAll(resource.data.invites))
        // Un voyageur quitte le voyage
        || (isMember() && !isOwner() && changed().hasOnly(["members", "emails"])
            && newData().members == resource.data.members.removeAll([uid()])
            && !(uid() in newData().emails))
        // Une personne invitée refuse : elle retire seulement sa propre adresse des invitations
        || (isInvited() && !isMember() && changed().hasOnly(["invites"])
            && newData().invites == resource.data.invites.removeAll([email()]))
        // Une personne invitée rejoint le voyage (après avoir cliqué sur « Rejoindre »)
        || (isInvited() && !isMember() && changed().hasOnly(["members", "invites", "emails", "joined"])
            && newData().members == resource.data.members.concat([uid()])
            && newData().invites == resource.data.invites.removeAll([email()])
            && newData().emails.diff(resource.data.emails).affectedKeys().hasOnly([uid()])
            // Son adresse affichée aux autres : la vraie, celle du compte
            && newData().emails[uid()] == request.auth.token.email
            // Date d'arrivée : la sienne seulement, fixée par Firebase, sans effacer celles des autres
            && (!("joined" in newData())
                || (newData().joined.diff("joined" in resource.data ? resource.data.joined : {}).affectedKeys().hasOnly([uid()])
                    && newData().joined.diff("joined" in resource.data ? resource.data.joined : {}).removedKeys().size() == 0
                    && newData().joined[uid()] == request.time)))
      );

      // Billets des trajets (un fichier par document, encodé en base64) :
      // seuls les voyageurs du voyage les voient, les ajoutent et les suppriment
      match /files/{fileId} {
        function tripMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
        }
        allow read, delete: if tripMember();
        allow create: if tripMember()
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 200
          // PDF ou photo JPEG seulement : un autre type pourrait exécuter du code à l'ouverture
          && request.resource.data.type in ["application/pdf", "image/jpeg"]
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      }
    }

    // ---------- Profils publics, abonnements, publications ----------

    // Pseudo unique : handles/{pseudo} = { uid }, réservé par son propriétaire
    match /handles/{handle} {
      allow read: if true;
      allow create: if request.auth != null
        && handle.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        // Réservé seulement avec le profil qui l'utilise (pas de pseudos réservés en masse)
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle == handle;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Profil : nom, pseudo, bio, compte public ou privé. Lisible par tous (comme une carte de visite),
    // mais la recherche (liste) demande un compte et rend 10 profils au plus
    match /profiles/{userId} {
      allow get: if true;
      allow list: if request.auth != null && request.query.limit <= 10;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["name", "nameLower", "handle", "bio", "visibility"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.visibility in ["public", "private"]
        // Le pseudo doit être réservé à son nom (dans la même écriture groupée)
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Abonnement : follows/{abonné}_{suivi} = { follower, followed, status, createdAt }
    // Compte public : abonnement immédiat (accepted). Compte privé : demande (pending) à accepter.
    // Seules les deux personnes concernées voient l'abonnement.
    match /follows/{followId} {
      function party() {
        return request.auth != null && (request.auth.uid == resource.data.follower || request.auth.uid == resource.data.followed);
      }
      allow read, delete: if party();
      allow create: if request.auth != null
        && followId == request.auth.uid + "_" + request.resource.data.followed
        && request.resource.data.keys().hasOnly(["follower", "followed", "status", "createdAt"])
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.followed != request.auth.uid
        && request.resource.data.createdAt == request.time
        // Il faut un profil public pour s'abonner : la personne suivie sait qui la suit
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && (request.resource.data.status == "pending"
            || (request.resource.data.status == "accepted"
                && get(/databases/$(database)/documents/profiles/$(request.resource.data.followed)).data.visibility == "public"));
      // La personne suivie accepte une demande (la date d'acceptation sert aux notifications)
      allow update: if request.auth != null && request.auth.uid == resource.data.followed
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedAt"])
        && request.resource.data.status == "accepted"
        && request.resource.data.acceptedAt == request.time;
    }

    // Publication : copie figée d'un itinéraire, sans prix, notes, adresses, liens ni billets.
    // Visibilité : public (tout le monde, même sans compte), followers (abonnés acceptés), private (moi seul)
    match /posts/{postId} {
      function isFollower(owner) {
        let f = /databases/$(database)/documents/follows/$(request.auth.uid + "_" + owner);
        return exists(f) && get(f).data.status == "accepted";
      }
      function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }

      allow read: if resource.data.visibility == "public"
        || (request.auth != null && (resource.data.owner == request.auth.uid
            || (resource.data.visibility == "followers" && isFollower(resource.data.owner))));
      allow create: if request.auth != null
        // Identifiant « p » + compte à rebours de l'heure : il doit correspondre à maintenant,
        // sinon on pourrait se placer en tête de Découvrir pour toujours (à une heure près, pour les horloges décalées)
        && postId.matches('^p[0-9]{13}[a-z0-9]{4,12}$')
        && math.abs((10000000000000 - int(postId[1:14])) - request.time.toMillis()) < 3600000
        && request.resource.data.publishedAt == request.time
        && request.resource.data.trip.keys().hasOnly(["country", "days", "nights", "items"])
        && request.resource.data.trip.items is list
        // Nombres de jours et de nuits : entiers (ou absents), jamais du texte
        && (!("days" in request.resource.data.trip) || request.resource.data.trip.days == null || request.resource.data.trip.days is int)
        && (!("nights" in request.resource.data.trip) || request.resource.data.trip.nights == null || request.resource.data.trip.nights is int)
        && request.resource.data.keys().hasOnly(["owner", "ownerName", "ownerHandle", "title", "visibility", "publishedAt", "trip", "recos"])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerName == profile().name
        && request.resource.data.ownerHandle == profile().handle
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.visibility in ["public", "followers", "private"]
        && request.resource.data.trip is map
        // Recommandations facultatives (restos, hébergements, adresses…) : 50 au plus
        && (!("recos" in request.resource.data) || (request.resource.data.recos is list && request.resource.data.recos.size() <= 50));
      // Non modifiable : seul son auteur change la visibilité ou la supprime
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visibility"])
        && request.resource.data.visibility in ["public", "followers", "private"];
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Commentaires : lisibles par qui voit l'itinéraire ; écrits par qui le voit et a un profil.
      // Supprimés par leur auteur, ou par l'auteur de l'itinéraire. Jamais modifiés.
      match /comments/{commentId} {
        function post() { return get(/databases/$(database)/documents/posts/$(postId)).data; }
        function canSeePost() {
          return post().visibility == "public"
            || (request.auth != null && (post().owner == request.auth.uid
                || (post().visibility == "followers" && isFollower(post().owner))));
        }
        allow read: if canSeePost();
        allow create: if request.auth != null && canSeePost()
          && request.resource.data.keys().hasOnly(["author", "authorName", "authorHandle", "text", "createdAt"])
          && request.resource.data.author == request.auth.uid
          && request.resource.data.authorName == profile().name
          && request.resource.data.authorHandle == profile().handle
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null
          && (resource.data.author == request.auth.uid || post().owner == request.auth.uid);
      }
    }
  }
}


